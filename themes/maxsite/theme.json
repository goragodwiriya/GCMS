{
    "name": "MaxSite",
    "version": "1.0.0",
    "author": "Goragod Wiriya",
    "author_url": "https://www.kotchasan.com",
    "description": "แม่แบบ 2 คอลัมน์ (เป็น 3 คอลัมน์ในหน้าแรก) เป็นแม่แบบยอดนิยมของเว็บโรงเรียน หรือเว็บ อบต.",
    "screenshot": "screenshot.webp",
    "license": "MIT",
    "layouts": [
        {
            "id": "main",
            "name": "Main Layout",
            "template": "index.html"
        },
        {
            "id": "auth",
            "name": "Auth Layout",
            "template": "login.html"
        },
        {
            "id": "blank",
            "name": "Blank",
            "template": "main.html"
        },
        {
            "id": "full-width",
            "name": "Full Width",
            "template": "main.html"
        }
    ],
    "components": [
        {
            "id": "header",
            "name": "Header",
            "template": "index.html#header"
        },
        {
            "id": "footer",
            "name": "Footer",
            "template": "index.html#footer"
        },
        {
            "id": "navbar",
            "name": "Navigation",
            "template": "index.html#nav"
        },
        {
            "id": "sidebar",
            "name": "Sidebar",
            "template": "index.html#sidebar"
        }
    ],
    "colors": {
        "primary": "#1098F3",
        "primary_hover": "#0e8bdf",
        "secondary": "#64748b",
        "accent": "#0ea5e9",
        "background": "#FFFFFF",
        "surface": "#F5F5F5",
        "text": "#333333",
        "text_secondary": "#475569",
        "border": "#c7d9f5"
    },
    "settings": {
        "show_sidebar": true,
        "sidebar_position": "both",
        "footer_columns": 3,
        "sticky_header": true,
        "hero_style": "gradient",
        "columns": 3
    }
