{
  "name": "Obsidian Theme",
  "version": "1.0.0",
  "author": "GCMS Designer",
  "author_url": "https://www.kotchasan.com",
  "description": "Dark mode theme — Charcoal + Indigo neon. Glass-morphism cards, sidebar-right layout.",
  "screenshot": "screenshot.webp",
  "license": "MIT",
  "layouts": [
    {
      "id": "main",
      "name": "Main Layout",
      "template": "index.html"
    },
    {
      "id": "auth",
      "name": "Auth Layout",
      "template": "login.html"
    },
    {
      "id": "blank",
      "name": "Blank",
      "template": "main.html"
    },
    {
      "id": "full-width",
      "name": "Full Width",
      "template": "main.html"
    }
  ],
  "components": [
    {
      "id": "header",
      "name": "Header",
      "template": "index.html#header"
    },
    {
      "id": "footer",
      "name": "Footer",
      "template": "index.html#footer"
    },
    {
      "id": "navbar",
      "name": "Navigation",
      "template": "index.html#nav"
    },
    {
      "id": "sidebar",
      "name": "Sidebar",
      "template": "index.html#sidebar"
    }
  ],
  "colors": {
    "primary": "#6366f1",
    "primary_hover": "#4f46e5",
    "secondary": "#94a3b8",
    "accent": "#22d3ee",
    "background": "#0f172a",
    "surface": "#1e293b",
    "text": "#e2e8f0",
    "text_secondary": "#94a3b8",
    "border": "#334155"
  },
  "settings": {
    "show_sidebar": true,
    "sidebar_position": "right",
    "footer_columns": 3,
    "sticky_header": true,
    "hero_style": "gradient",
    "columns": 2,
    "color_scheme": "dark"
  },
  "designer": {
    "compatible": true,
    "editable": true
  }
}