{
  "name": "BlueWave Theme",
  "version": "1.0.0",
  "author": "GCMS Designer",
  "author_url": "https://www.kotchasan.com",
  "description": "Theme สามคอลัมน์สีฟ้า — sidebar ซ้าย + เนื้อหาหลัก + sidebar ขวา",
  "screenshot": "screenshot.webp",
  "license": "MIT",
  "layouts": [
    {
      "id": "main",
      "name": "Main Layout",
      "template": "index.html"
    },
    {
      "id": "auth",
      "name": "Auth Layout",
      "template": "login.html"
    },
    {
      "id": "blank",
      "name": "Blank",
      "template": "main.html"
    },
    {
      "id": "full-width",
      "name": "Full Width",
      "template": "main.html"
    }
  ],
  "components": [
    {
      "id": "header",
      "name": "Header",
      "template": "index.html#header"
    },
    {
      "id": "footer",
      "name": "Footer",
      "template": "index.html#footer"
    },
    {
      "id": "navbar",
      "name": "Navigation",
      "template": "index.html#nav"
    },
    {
      "id": "sidebar",
      "name": "Sidebar",
      "template": "index.html#sidebar"
    }
  ],
  "colors": {
    "primary": "#1d6fe8",
    "primary_hover": "#1558c0",
    "secondary": "#64748b",
    "accent": "#0ea5e9",
    "background": "#f0f6ff",
    "surface": "#e8f0fe",
    "text": "#1e293b",
    "text_secondary": "#475569",
    "border": "#c7d9f5"
  },
  "settings": {
    "show_sidebar": true,
    "sidebar_position": "both",
    "footer_columns": 3,
    "sticky_header": true,
    "hero_style": "gradient",
    "columns": 3
  },
  "designer": {
    "compatible": true,
    "editable": true
  }
}