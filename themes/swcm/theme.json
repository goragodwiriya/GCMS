{
  "name": "SWCM Theme",
  "version": "1.0.0",
  "author": "Goragod Wiriya",
  "author_url": "https://goragod.com",
  "description": "Theme เว็บไซต์โรงเรียนหรือราชการ สีน้ำเงิน-แดง สองคอลัมน์",
  "screenshot": "screenshot.svg",
  "license": "MIT",
  "layouts": [
    "main",
    "auth",
    "blank",
    "full-width"
  ],
  "components": [
    "header",
    "footer",
    "navbar",
    "sidebar",
    "breadcrumb",
    "pagination"
  ],
  "colors": {
    "primary": "#003087",
    "primary_hover": "#002266",
    "secondary": "#c8102e",
    "accent": "#c8102e",
    "background": "#ffffff",
    "text": "#1a1a2e"
  },
  "settings": {
    "show_sidebar": true,
    "sidebar_position": "left",
    "footer_columns": 4,
    "show_breadcrumb": true,
    "show_search": true,
    "products_per_page": 12
  },
  "designer": {
    "compatible": true,
    "editable": true
  }
}