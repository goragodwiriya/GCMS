{
  "name": "Default Theme",
  "version": "1.0.0",
  "author": "Goragod Wiriya",
  "author_url": "https://goragod.com",
  "description": "A clean and modern default theme for the bookstore.",
  "screenshot": "screenshot.svg",
  "license": "MIT",
  "layouts": [
    "main",
    "auth",
    "blank",
    "full-width"
  ],
  "components": [
    "header",
    "footer",
    "navbar",
    "sidebar",
    "breadcrumb",
    "pagination"
  ],
  "colors": {
    "primary": "#2563eb",
    "primary_hover": "#1d4ed8",
    "secondary": "#6b7280",
    "accent": "#10b981",
    "background": "#ffffff",
    "text": "#1e293b"
  },
  "settings": {
    "show_sidebar": true,
    "sidebar_position": "right",
    "footer_columns": 4,
    "show_breadcrumb": true,
    "show_search": true,
    "products_per_page": 12
  },
  "designer": {
    "compatible": true,
    "editable": true
  }
}