{
  "name": "Flavor",
  "version": "1.0.0",
  "author": "Goragod Wiriya",
  "author_url": "https://goragod.com",
  "description": "A modern, section-based theme designed for the GCMS Visual Designer. Clean lines, flexible layouts, and full drag-drop support.",
  "screenshot": "screenshot.svg",
  "license": "MIT",
  "layouts": [
    "main",
    "full-width",
    "sidebar-left",
    "sidebar-right",
    "blank"
  ],
  "components": [
    "header",
    "hero",
    "content",
    "features",
    "stats",
    "cta",
    "footer",
    "sidebar",
    "breadcrumb",
    "pagination"
  ],
  "colors": {
    "primary": "#6366f1",
    "primary_hover": "#4f46e5",
    "secondary": "#64748b",
    "accent": "#06b6d4",
    "success": "#22c55e",
    "warning": "#f59e0b",
    "error": "#ef4444",
    "background": "#ffffff",
    "surface": "#f8fafc",
    "text": "#0f172a",
    "text_secondary": "#64748b",
    "border": "#e2e8f0",
    "footer_bg": "#0f172a",
    "footer_text": "#cbd5e1"
  },
  "settings": {
    "show_sidebar": false,
    "sidebar_position": "right",
    "footer_columns": 3,
    "show_breadcrumb": true,
    "show_search": true,
    "header_style": "sticky",
    "hero_style": "gradient"
  },
  "designer": {
    "compatible": true,
    "editable": true
  }
}