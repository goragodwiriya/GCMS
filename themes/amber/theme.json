{
  "name": "Amber Theme",
  "version": "1.0.0",
  "author": "GCMS Designer",
  "author_url": "https://www.kotchasan.com",
  "description": "Warm government/education theme — Amber + Deep Brown. Sidebar-left layout, paper feel.",
  "screenshot": "screenshot.svg",
  "license": "MIT",
  "layouts": [
    {
      "id": "main",
      "name": "Main Layout",
      "template": "index.html"
    },
    {
      "id": "auth",
      "name": "Auth Layout",
      "template": "login.html"
    },
    {
      "id": "blank",
      "name": "Blank",
      "template": "main.html"
    },
    {
      "id": "full-width",
      "name": "Full Width",
      "template": "main.html"
    }
  ],
  "components": [
    {
      "id": "header",
      "name": "Header",
      "template": "index.html#header"
    },
    {
      "id": "footer",
      "name": "Footer",
      "template": "index.html#footer"
    },
    {
      "id": "navbar",
      "name": "Navigation",
      "template": "index.html#nav"
    },
    {
      "id": "sidebar",
      "name": "Sidebar",
      "template": "index.html#sidebar"
    }
  ],
  "colors": {
    "primary": "#d97706",
    "primary_hover": "#b45309",
    "secondary": "#78350f",
    "accent": "#f59e0b",
    "background": "#fffbeb",
    "surface": "#fef3c7",
    "text": "#1c1917",
    "text_secondary": "#57534e",
    "border": "#fcd34d"
  },
  "settings": {
    "show_sidebar": true,
    "sidebar_position": "left",
    "columns": 2,
    "footer_columns": 3,
    "show_breadcrumb": true,
    "show_search": true,
    "color_scheme": "light"
  },
  "designer": {
    "compatible": true,
    "editable": true
  }
}