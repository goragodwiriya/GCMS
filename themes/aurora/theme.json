{
  "name": "Aurora Civic Theme",
  "version": "1.0.0",
  "author": "GCMS Designer",
  "author_url": "https://www.kotchasan.com",
  "description": "Warm editorial theme with teal-orange accents, glass header, and readable content panels.",
  "screenshot": "screenshot.svg",
  "license": "MIT",
  "layouts": [
    {
      "id": "main",
      "name": "Main Layout",
      "template": "index.html"
    },
    {
      "id": "auth",
      "name": "Auth Layout",
      "template": "login.html"
    },
    {
      "id": "blank",
      "name": "Blank",
      "template": "main.html"
    },
    {
      "id": "full-width",
      "name": "Full Width",
      "template": "main.html"
    }
  ],
  "components": [
    {
      "id": "header",
      "name": "Header",
      "template": "index.html#header"
    },
    {
      "id": "footer",
      "name": "Footer",
      "template": "index.html#footer"
    },
    {
      "id": "navbar",
      "name": "Navigation",
      "template": "index.html#nav"
    },
    {
      "id": "sidebar",
      "name": "Sidebar",
      "template": "index.html#sidebar"
    }
  ],
  "colors": {
    "primary": "#0f766e",
    "primary_hover": "#0b5f58",
    "secondary": "#92400e",
    "accent": "#f97316",
    "background": "#fffaf2",
    "surface": "#ffffff",
    "text": "#1f2937",
    "text_secondary": "#4b5563",
    "border": "#eadfce"
  },
  "settings": {
    "show_sidebar": true,
    "sidebar_position": "left",
    "footer_columns": 3,
    "sticky_header": true,
    "hero_style": "gradient",
    "columns": 2
  },
  "designer": {
    "compatible": true,
    "editable": true
  }
}