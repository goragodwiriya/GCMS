        },
        {
            "id": "full-width",
            "name": "Full Width",
            "template": "main.html"
        }
    ],
    "components": [
        {
            "id": "header",
            "name": "Header",
            "template": "index.html#header"
        },
        {
            "id": "footer",
            "name": "Footer",
            "template": "index.html#footer"
        },
        {
            "id": "navbar",
            "name": "Navigation",
            "template": "index.html#nav"
        },
        {
            "id": "sidebar",
            "name": "Sidebar",
            "template": "index.html#sidebar"
        }
    ],
    "colors": {
        "primary": "#33B9A3",
        "primary_hover": "#217c6d",
        "secondary": "#64748b",
        "accent": "#2da38f",
        "background": "#FFFFFF",
        "surface": "#F5F5F5",
        "text": "#333333",
        "text_secondary": "#475569",
