{
  "name": "e-Commerce",
  "version": "1.0.0",
  "author": "Goragod Wiriya",
  "author_url": "https://goragod.com",
  "description": "Theme หนึ่งคอลัมน์ เหมาะสำหรับร้านค้าออนไลน์ (e-commerce)",
  "screenshot": "screenshot.webp",
